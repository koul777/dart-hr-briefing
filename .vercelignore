# Default-deny the upload set. Every Vercel runtime file must be named below.
# This keeps untracked local media/build artifacts out of `vercel deploy` too.
/*

!/api
!/api/__init__.py
!/api/index.py

!/schemas
!/schemas/workforce_orchestration_v2.schema.json

!/seed
!/seed/classroom_workforce_2024_11011.json
!/seed/corp_codes.json.gz

!/static
!/static/app.js
!/static/index.html
!/static/styles.css

!/HR_BRIEFING_RULES.md
!/.python-version
!/agent_orchestration.py
!/analysis_contract.py
!/claude_mcp_adapter.py
!/classroom_mode.py
!/openai_responses_adapter.py
!/orchestration_evaluation.py
!/orchestrator.py
!/pyproject.toml
!/runtime_controls.py
!/server.py
!/uv.lock
!/vercel.json
!/workforce_analytics.py
