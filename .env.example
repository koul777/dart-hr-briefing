# OpenDART API 인증키(40자리)
OPENDART_API_KEY=

# Optional fallback for automation. Interactive users enter their own key in the sidebar.
# Never commit a real key. Keys entered in the UI are not written to this file.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna
OPENAI_TIMEOUT_SECONDS=60
OPENAI_MAX_OUTPUT_TOKENS=1800
# Public requests never spend the server-side provider key by default. Only
# enable this for a separately authenticated operator path with a random token.
DART_ALLOW_OPERATOR_AI_PROVIDER=false
DART_OPERATOR_AI_TOKEN=

# Runtime safeguards for outbound DART traffic and public API usage.
DART_CACHE_TTL_SECONDS=300
DART_CACHE_MAX_ENTRIES=512
DART_CACHE_MAX_BYTES=67108864
# Optional override. Frozen builds otherwise use %LOCALAPPDATA%\DART-HR-Briefing.
DART_DATA_DIR=
DART_RETRY_ATTEMPTS=3
DART_RETRY_BASE_DELAY_MS=250
# Per OpenDART attempt. The default keeps three sequential People endpoints
# inside a typical serverless request deadline even when retries are needed.
DART_REQUEST_TIMEOUT_SECONDS=10
# Shared by every real OpenDART attempt spawned from one HTTP request. Cache hits
# do not consume attempts; exhaustion returns recoverable partial results.
DART_OUTBOUND_DEADLINE_SECONDS=35
DART_OUTBOUND_ATTEMPT_BUDGET=48
DART_RATE_LIMIT_PER_MINUTE=30
DART_RATE_LIMIT_MAX_CLIENTS=4096
DART_OPEN_BROWSER=true
# Optional release identifier. Vercel/GitHub builds otherwise use their commit SHA;
# frozen builds show an executable SHA-256 prefix.
DART_BUILD_ID=
# Validate every v2 orchestration response against the bundled contract.
DART_STRICT_ORCHESTRATION_SCHEMA=true

# Optional: only when a separately provisioned Claude Code MCP gateway exists.
CLAUDE_MCP_GATEWAY_URL=
CLAUDE_MCP_GATEWAY_TOKEN=
CLAUDE_MCP_GATEWAY_TIMEOUT_SECONDS=20
