{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/index.py": {
      "maxDuration": 120,
      "excludeFiles": "{.env*,dist/**,reports/**,training_deck/**,docs/**,test_*.py,*.exe,*.pptx,*.mp4}"
    }
  },
  "routes": [
    {
      "src": "/(.*)",
      "dest": "/api/index?__route=$1"
    }
  ]
}
